<?xml version="1.0"?>
<recovery>
	<details>
		<resolution width="1920" height="1200"/>
		<author>Ahmed Younis (AKRO)</author>
		<title>TWRP Recovery</title>
		<description>Custom Splash Screen - Cyber Edition</description>
		<themeversion>3.0</themeversion>
	</details>

	<resources>
		<font name="font_l" filename="RobotoCondensed-Regular.ttf" size="52"/>
		<image name="splashlogo" filename="splashlogo" retainaspect="1"/>
		<image name="splashteamwin" filename="splashteamwin" retainaspect="1"/>
	</resources>

	<variables>
		<variable name="screen_width" value="1920"/>
		<variable name="screen_height" value="1200"/>
		<variable name="background_color" value="#000000"/>
		<variable name="text_color" value="#FFFFFF"/>
		<variable name="accent_color" value="#007BFF"/> <variable name="highlight_color" value="#FF8C00"/> <variable name="header_color" value="#000000"/>
	</variables>

	<pages>
		<page name="splash">
			<background color="%background_color%"/>

			<fill color="%accent_color%">
				<placement x="0" y="0" w="%screen_width%" h="10"/>
			</fill>

			<image>
				<image resource="splashlogo"/>
				<placement x="960" y="320" placement="4"/>
			</image>

			<image>
				<image resource="splashteamwin"/>
				<placement x="960" y="920" placement="4"/>
			</image>

			<text color="%highlight_color%">
				<font resource="font_l"/>
				<placement x="960" y="970" placement="5"/>
				<text>AKRO %tw_version%</text>
			</text>

			<text color="%text_color%">
				<font resource="font_l"/>
				<placement x="960" y="1050" placement="5"/>
				<text>Developed by Ahmed Younis</text>
			</text>
		</page>
	</pages>
</recovery>
